      "(i) અનુરૂપ ઘટકો: $4=y$",
      "$3=z$",
      "$x=1$",
      "$(x,y,z)=(1,4,3)$",
      "(ii) $x+y=6$",
      "$5+z=5\\Rightarrow z=0$",
      "$xy=8$",
      "$y=6-x$",
      "$x(6-x)=8$",
      "$6x-x^2=8$",
      "$x^2-6x+8=0$",
      "$x^2-2x-4x+8=0$",
      "$x(x-2)-4(x-2)=0$",
      "$(x-2)(x-4)=0$",
      "$x=2$ અથવા $x=4$",
      "$x=2\\Rightarrow y=6-2=4$",
      "$x=4\\Rightarrow y=6-4=2$",
      "$2+4=6,\\quad2(4)=8,\\quad5+0=5$",
      "$4+2=6,\\quad4(2)=8,\\quad5+0=5$",
      "$(x,y,z)=(2,4,0)$ અથવા $(4,2,0)$",
      "(iii) $x+y+z=9\\quad(1)$",
      "$x+z=5\\quad(2)$",
      "$y+z=7\\quad(3)$",
      "$(1)-(2):\\quad x+y+z-x-z=9-5$",
      "$y=4$",
      "$4+z=7$",
      "$z=7-4=3$",
      "$x+3=5$",
      "$x=5-3=2$",
      "$2+4+3=9,\\quad2+3=5,\\quad4+3=7$",
      "$(x,y,z)=(2,4,3)$"
    ]
